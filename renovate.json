{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommitTypeAll(chore)",
    "schedule:daily",
    "group:all"
  ],
  "configMigration": true,
  "constraints": {
    "go": "1.27"
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?( registryUrl=(?<registryUrl>.*?))?\\s.*?_VERSION\\s?[:?]?=\\s?(?<currentValue>.*)\\s"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      "description": [
        "Custom dependency manager for updating tools defined in Makefiles."
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "ENVTEST_K8S_VERSION\\s*:?=\\s*(?<currentValue>.*)\\s"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "envtest",
      "packageNameTemplate": "kubernetes-sigs/controller-tools",
      "extractVersionTemplate": "^envtest-v(?<version>.*)$",
      "versioningTemplate": "semver",
      "description": [
        "setup-envtest can only use Kubernetes versions that have published envtest binaries, which ship as envtest-v* releases of controller-tools."
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "KIND_IMAGE\\s*\\?*=\\s*kindest/node:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "kindest/node",
      "description": [
        "The KIND node image is not a *_VERSION variable, so the general Makefile manager does not see it."
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^e2e/internal/fixture/curlpod\\.go$/"
      ],
      "matchStrings": [
        "\"curlimages/curl:(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "curlimages/curl",
      "description": [
        "The e2e curl pod's image is a Go string literal, which no built-in manager reads."
      ]
    }
  ],
  "enabled": true,
  "enabledManagers": [
    "custom.regex",
    "dockerfile",
    "github-actions",
    "gomod",
    "helm-values",
    "helmv3",
    "kubernetes",
    "kustomize",
    "asdf",
    "bundler"
  ],
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchDepNames": [
        "sigstore/cosign-installer"
      ],
      "allowedVersions": "<4",
      "description": [
        "Installer v4 ships cosign 3, which signs with the new bundle format by default; consumers verifying with cosign 2 break. Lift deliberately, with a verification story."
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "helm"
      ],
      "allowedVersions": "<4",
      "description": [
        "The helm CLI on the chart package/push path stays on 3.x until Helm 4 is verified against the release workflow."
      ]
    },
    {
      "matchPackageNames": [
        "k8s.io/client-go"
      ],
      "allowedVersions": "/^v[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?$/"
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "minimumReleaseAge": "60 days",
      "matchPackageNames": [
        "k8s.io{/,}**"
      ]
    },
    {
      "matchFileNames": [
        "Makefile"
      ],
      "extractVersion": "^v(?<version>.*)$",
      "description": [
        "Add build label to PRs which are related to build tools defined in Makefiles.",
        "Group Makefile dependency updates in single PR."
      ],
      "matchDepNames": [
        "!envtest"
      ]
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "printConfig": false,
  "rebaseWhen": "behind-base-branch",
  "semanticCommits": "enabled",
  "timezone": "Etc/UTC"
}
